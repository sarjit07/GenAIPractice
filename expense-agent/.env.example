# Copy to .env and adjust if your vLLM server isn't on the defaults below.
# cli.py loads this automatically via python-dotenv.

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=expense-cat
CACHE_PATH=.cache/merchant_categories.json
OUTPUT_PATH=outputs/statement-report.html

# Optional — helps self-transfer detection when the CSV's own /P2V/ marker
# doesn't cover every self-transfer in the statement.
HOLDER_NAME=
